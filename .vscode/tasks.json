{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Concat files",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./util/concat-from-clipboard.ps1",
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Run client",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    },
    {
      "label": "Generate schemas",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "tsx",
        "../util/generate-schemas.ts"
      ],
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "pnpm build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Build Client",
      "dependsOn": [
        "Build"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "docker-build-client"
      ],
      "problemMatcher": []
    }
    {
      "label": "Docker: Run Client",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "docker-run-client"
      ],
      "problemMatcher": []
    },
    {
      "label": "Docker: Test Client",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "docker-test-client"
      ],
      "problemMatcher": []
    }
  ]
}