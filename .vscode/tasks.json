{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Concat files",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./util/concat-from-clipboard.ps1",
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Run client",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    }
  ]
}