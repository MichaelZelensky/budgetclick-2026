#!/usr/bin/env bash

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
client_dist_dir="$repo_dir/client/dist"

if [[ "${1:-test}" == "prod" ]]; then
    production_repo_dir="/c/--backedup/work/git/budgetclick.com-pwa"
    production_pwa_dir="$production_repo_dir/public/pwa"
    base_path="/pwa/"
    config_source="$repo_dir/client-config/config.prod.json"
    deployment_name="budgetclick.com (prod)"
elif [[ "${1:-test}" == "test" ]]; then
    production_repo_dir="/c/--backedup/work/git/liteed.com"
    production_pwa_dir="$production_repo_dir/public/bc-pwa"
    base_path="/bc-pwa/"
    config_source="$repo_dir/client-config/config.test.json"
    deployment_name="liteed.com (test)"
else
    echo "ERROR: Unknown deployment target: $1"
    exit 1
fi

if [[ ! -f "$config_source" ]]; then
    echo "ERROR: Config file does not exist: $config_source"
    exit 1
fi

echo "==> Testing BudgetClick..."
(
    cd "$repo_dir"
    pnpm test-client
)

echo "==> Removing previous build..."
rm -rf "$client_dist_dir"

echo "==> Building BudgetClick..."
(
    cd "$repo_dir/client"
    MSYS_NO_PATHCONV=1 VITE_BASE_PATH="$base_path" pnpm build
)

if [[ ! -d "$client_dist_dir" ]]; then
    echo "ERROR: Build directory does not exist: $client_dist_dir"
    exit 1
fi

if [[ ! -d "$production_repo_dir/.git" ]]; then
    echo "ERROR: Production directory is not a Git repository: $production_repo_dir"
    exit 1
fi

if [[ "$production_pwa_dir" != */public/pwa && "$production_pwa_dir" != */public/bc-pwa ]]; then
    echo "ERROR: Refusing to remove unexpected path: $production_pwa_dir"
    exit 1
fi

echo "==> Deploying to $deployment_name..."
echo "==> Removing previous PWA deployment..."
rm -rf "$production_pwa_dir"

echo "==> Copying new PWA deployment..."
mkdir -p "$production_pwa_dir"
cp -R "$client_dist_dir"/. "$production_pwa_dir"/

echo "==> Applying deployment config..."
cp "$config_source" "$production_pwa_dir/config.json"

echo "==> Staging PWA deployment..."
git -C "$production_repo_dir" add "public/$(basename "$production_pwa_dir")"

if git -C "$production_repo_dir" diff --cached --quiet -- "public/$(basename "$production_pwa_dir")"; then
    echo "==> No changes to deploy."
    exit 0
fi

echo "==> Committing..."
git -C "$production_repo_dir" commit -m "Deploy BudgetClick PWA"

echo "==> Pushing..."
git -C "$production_repo_dir" push

echo
echo "==> BudgetClick PWA deployed successfully to $deployment_name."